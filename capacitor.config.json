{
  "appId": "place.run.iskraai.mobile",
  "appName": "Iskra",
  "webDir": "out",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "url": "https://iskraai.pages.dev",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0d0f12"
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    }
  }
}
